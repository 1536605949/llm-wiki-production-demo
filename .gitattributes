# 统一换行符，避免 Windows 的 CRLF 污染 Linux/Docker 构建
* text=auto eol=lf

# Shell 与容器脚本必须 LF
*.sh          text eol=lf
Dockerfile    text eol=lf
Makefile      text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf

# Windows 脚本保留 CRLF
*.bat         text eol=crlf
*.ps1         text eol=crlf

# 二进制文件不做换行转换
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.pdf         binary
*.zip         binary

# 语言统计：Markdown 是本项目的知识制品，排除自动生成的目录文件
demo/wiki/index.md  linguist-generated=true
demo/wiki/log.md    linguist-generated=true
