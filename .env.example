# LLM-Wiki 环境变量模板
#
# 复制为 .env 后按需修改：
#   cp .env.example .env
#
# 默认使用 mock provider，不需要任何 API Key 就能跑通完整生命周期。
# mock 是确定性启发式逻辑，它不会伪装成真实大模型。

# ---- Provider 选择 ----
# mock              = 确定性启发式，无需 Key（默认）
# openai_compatible = 任意 OpenAI 兼容的 Chat Completions 服务
LLMWIKI_PROVIDER=mock

# ---- 真实 LLM 配置（仅 provider=openai_compatible 时生效）----
# 本地 Ollama（注意 base_url 要带 /v1）
LLMWIKI_BASE_URL=http://localhost:11434/v1
LLMWIKI_MODEL=qwen3:8b
LLMWIKI_API_KEY=ollama

# 其他常见组合：
#   vLLM      -> http://localhost:8000/v1   ，model 自定
#   LM Studio -> http://localhost:1234/v1   ，model 自定
#   OpenAI    -> https://api.openai.com/v1  ，model=gpt-4o-mini

# ---- 请求超时（秒）----
LLMWIKI_TIMEOUT_SECONDS=120

# ---- 每次 ingest / save-back 后自动 git 提交 ----
LLMWIKI_AUTO_GIT_COMMIT=false
